# Copia este archivo como ".env" y llena tus datos.
# El archivo .env NO se sube a GitHub (cada quien tiene el suyo).

# Puerto donde corre la página: http://localhost:3000
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=seminuevos_db

# Texto secreto para firmar la sesión (cualquier frase larga)
SESSION_SECRET=cambia_esta_frase_por_una_larga_y_secreta
